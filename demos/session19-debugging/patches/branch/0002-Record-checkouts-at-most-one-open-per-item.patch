diff --git a/catalog/models.py b/catalog/models.py
index 3bc720a..1d398d3 100644
--- a/catalog/models.py
+++ b/catalog/models.py
@@ -1,4 +1,5 @@
 from django.db import models
+from django.utils import timezone
 
 
 class Bin(models.Model):
@@ -43,3 +44,57 @@ class Item(models.Model):
 
     def __str__(self):
         return self.name
+
+
+class Person(models.Model):
+    """Someone items go out to: in version 1, an actor."""
+
+    name = models.CharField(max_length=120)
+    phone = models.CharField(max_length=30, blank=True)
+
+    class Meta:
+        ordering = ["name"]
+        verbose_name_plural = "people"
+
+    def __str__(self):
+        return self.name
+
+
+class Show(models.Model):
+    """A production that items are checked out for."""
+
+    title = models.CharField(max_length=120)
+    opening_date = models.DateField(null=True, blank=True)
+
+    class Meta:
+        ordering = ["-opening_date", "title"]
+
+    def __str__(self):
+        return self.title
+
+
+class Checkout(models.Model):
+    """One item out to one person for one show. Open until it has a returned date."""
+
+    # PROTECT: an item, person, or show with checkouts can't be deleted out from under them.
+    item = models.ForeignKey(Item, on_delete=models.PROTECT, related_name="checkouts")
+    person = models.ForeignKey(Person, on_delete=models.PROTECT, related_name="checkouts")
+    show = models.ForeignKey(Show, on_delete=models.PROTECT, related_name="checkouts")
+    out_date = models.DateField(default=timezone.localdate)
+    due_date = models.DateField()
+    returned_date = models.DateField(null=True, blank=True)
+
+    class Meta:
+        ordering = ["-out_date"]
+        constraints = [
+            # Design §5: at most one open checkout per item, enforced by the
+            # database, so two volunteers saving at once can't both succeed.
+            models.UniqueConstraint(
+                fields=["item"],
+                condition=models.Q(returned_date__isnull=True),
+                name="one_open_checkout_per_item",
+            ),
+        ]
+
+    def __str__(self):
+        return f"{self.item} to {self.person}"
