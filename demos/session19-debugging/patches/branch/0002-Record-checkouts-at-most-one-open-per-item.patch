 class ItemListTests(TestCase):
@@ -51,3 +54,37 @@ class ItemSearchTests(TestCase):
         response = self.search("tiara")
 
         self.assertContains(response, "No items match")
+
+
+class CheckoutTests(TestCase):
+    def setUp(self):
+        bin_a = Bin.objects.create(label="A-01")
+        self.item = Item.objects.create(name="Victorian waistcoat", size_label="M", bin=bin_a)
+        self.sam = Person.objects.create(name="Sam Ellis")
+        self.jo = Person.objects.create(name="Jo Park")
+        self.show = Show.objects.create(title="The Importance of Being Earnest")
+
+    def check_out(self, person):
+        return Checkout.objects.create(
+            item=self.item, person=person, show=self.show, due_date=date(2026, 12, 5)
+        )
+
+    def test_records_a_first_checkout(self):
+        self.check_out(self.sam)
+
+        self.assertEqual(self.item.checkouts.get().person, self.sam)
+
+    def test_refuses_a_second_open_checkout_of_the_same_item(self):
+        self.check_out(self.sam)
+
+        with self.assertRaises(IntegrityError), transaction.atomic():
+            self.check_out(self.jo)
+
+    def test_allows_a_new_checkout_once_the_item_is_returned(self):
+        first = self.check_out(self.sam)
+        first.returned_date = date(2026, 11, 20)
+        first.save()
+
+        self.check_out(self.jo)
+
+        self.assertEqual(self.item.checkouts.count(), 2)
