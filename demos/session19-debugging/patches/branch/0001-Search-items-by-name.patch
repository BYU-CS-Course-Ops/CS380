From 2ef3854602077a8f85c91428c7dc048bcf6a4406 Mon Sep 17 00:00:00 2001
From: Tom Stephens <tstephen@cs.byu.edu>
Date: Sat, 24 Oct 2026 07:45:24 -0600
Subject: [PATCH 1/3] Search items by name

A search box at the top of the item list filters it to items whose
name contains the text, ignoring case and surrounding spaces. An empty
search shows the full list; a search that finds nothing says so.
---
 catalog/templates/catalog/item_list.html |  7 ++++++
 catalog/tests.py                         | 31 ++++++++++++++++++++++++
 catalog/views.py                         |  5 +++-
 3 files changed, 42 insertions(+), 1 deletion(-)

diff --git a/catalog/templates/catalog/item_list.html b/catalog/templates/catalog/item_list.html
index 4ed51d0..ad8f70e 100644
--- a/catalog/templates/catalog/item_list.html
+++ b/catalog/templates/catalog/item_list.html
@@ -6,6 +6,11 @@
 </head>
 <body>
   <h1>Catalog</h1>
+  <form method="get" role="search">
+    <label for="q">Search by name</label>
+    <input id="q" name="q" type="search" value="{{ query }}">
+    <button type="submit">Search</button>
+  </form>
   {% if items %}
     <table>
       <thead>
@@ -23,6 +28,8 @@
         {% endfor %}
       </tbody>
     </table>
+  {% elif query %}
+    <p>No items match “{{ query }}”.</p>
   {% else %}
     <p>Nothing in the catalog yet. Add items in the admin.</p>
   {% endif %}
diff --git a/catalog/tests.py b/catalog/tests.py
index 6c2de9f..0710d33 100644
--- a/catalog/tests.py
+++ b/catalog/tests.py
@@ -20,3 +20,34 @@ class ItemListTests(TestCase):
         response = self.client.get(reverse("catalog:item_list"))
 
         self.assertContains(response, "Nothing in the catalog yet")
+
+
+class ItemSearchTests(TestCase):
+    def setUp(self):
+        bin_a = Bin.objects.create(label="A-01")
+        Item.objects.create(name="Bustle skirt, black", bin=bin_a)
+        Item.objects.create(name="Bowler hat", bin=bin_a)
+
+    def search(self, query):
+        return self.client.get(reverse("catalog:item_list"), {"q": query})
+
+    def test_finds_items_by_part_of_the_name(self):
+        response = self.search("bustle")
+
+        self.assertContains(response, "Bustle skirt, black")
+        self.assertNotContains(response, "Bowler hat")
+
+    def test_ignores_case(self):
+        response = self.search("BOWLER")
+
+        self.assertContains(response, "Bowler hat")
+
+    def test_ignores_spaces_around_the_query(self):
+        response = self.search("  bustle ")
+
+        self.assertContains(response, "Bustle skirt, black")
+
+    def test_says_so_when_nothing_matches(self):
+        response = self.search("tiara")
+
+        self.assertContains(response, "No items match")
diff --git a/catalog/views.py b/catalog/views.py
index eb4bc10..0ecbd2c 100644
--- a/catalog/views.py
+++ b/catalog/views.py
@@ -4,5 +4,8 @@ from .models import Item
 
 
 def item_list(request):
+    query = request.GET.get("q", "").strip()
     items = Item.objects.select_related("bin")
-    return render(request, "catalog/item_list.html", {"items": items})
+    if query:
+        items = items.filter(name__icontains=query)
+    return render(request, "catalog/item_list.html", {"items": items, "query": query})
