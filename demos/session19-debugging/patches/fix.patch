+    def test_marks_only_the_item_that_is_out(self):
+        waistcoat = Item.objects.create(name="Victorian waistcoat", bin=self.bin_a)
+        Item.objects.create(name="Bowler hat", bin=self.bin_a)
+        Checkout.objects.create(item=waistcoat, person=self.sam, show=self.show, due_date=date(2026, 12, 5))
+
+        response = self.client.get(reverse("catalog:item_list"))
+
+        due_back = {item.name: item.due_back for item in response.context["items"]}
+        self.assertEqual(due_back, {"Bowler hat": None, "Victorian waistcoat": date(2026, 12, 5)})
