        <item type="subheader" id="sub-res-writing" title="Writing &amp; proposals" />
            <item type="page" content_id="pg-proposal-anatomy-reading" indent="1" />
            <item type="page" content_id="pg-prd-reference" indent="1" />
            <item type="page" content_id="pg-sample-proposal-weak" indent="1" />
            <item type="page" content_id="pg-sample-proposal-strong" indent="1" />

        <item type="subheader" id="sub-res-openSource" title="Open source" />
            <item type="page"        content_id="pg-license-cheat-sheet" indent="1" />
            <item type="ExternalURL" id="res-cps-handbook" title="Creative Problem Solving handbook (PDF)"
                  external_url="{{ CPS_HANDBOOK_URL }}" indent="1" />

        <item type="subheader" id="sub-res-evaluation" title="Evaluation instruments" />
            <item type="page" content_id="pg-pitch-evaluation-sheet" indent="1" />
            <item type="page" content_id="pg-peer-evaluation-form" indent="1" />
    </module>

    <module id="mod-phase-1" title="Phase 1 — Clarify &amp; Explore" published="true">
        <item type="page"       content_id="s01" />
        <item type="page"       content_id="s02" />
        <item type="page"       content_id="s03" />
        <item type="page"       content_id="s04" />
        <item type="page"       content_id="s05" />
            <item type="assignment" content_id="license-oss" indent="1" />
